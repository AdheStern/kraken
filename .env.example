# .env.example
# Variables de entorno de Kraken by DIMA (AGENTS.md §10). Copiar a .env; nunca subir valores reales.

# Base de datos: usuario de la app (sin DDL) y usuario de migraciones
DATABASE_URL=postgresql://dima:dima@localhost:5432/dima_hub
MIGRATION_DATABASE_URL=postgresql://dima:dima@localhost:5432/dima_hub

# Sesiones (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Inicio de sesión con Entra ID (permisos delegados)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Cuenta de emergencia del administrador del sistema: solo la lee `pnpm db:seed:admin`
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Correo por Microsoft Graph (registro de app separado, solo Mail.Send)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=

# Tipo de cambio
FX_API_URL=https://apibcb.cucu.bo/api/v1/tc/oficial

# Punto de montaje NFS de adjuntos
FILES_ROOT=
