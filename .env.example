# .env.example
# Variables de entorno de Kraken by DIMA (AGENTS.md §10). Copiar a .env; nunca subir valores reales.

# Base de datos: usuario de la app (sin DDL) y usuario de migraciones
DATABASE_URL=postgresql://dima:dima@localhost:5432/dima_hub
MIGRATION_DATABASE_URL=postgresql://dima:dima@localhost:5432/dima_hub

# Sesiones (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Inicio de sesión con Entra ID (permisos delegados)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Cuenta de emergencia del administrador del sistema: solo la lee `pnpm db:seed:admin`
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Correo por Microsoft Graph (registro de app separado, solo Mail.Send; usa ENTRA_TENANT_ID)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=

# Tipo de cambio
FX_API_URL=https://apibcb.cucu.bo/api/v1/tc/oficial

# Solo desarrollo: Mailpit recibe los correos si Graph no está configurado
MAILPIT_URL=http://localhost:8025

# Adjuntos en SharePoint por Microsoft Graph (ADR-16; usa ENTRA_TENANT_ID). Registro de app separado con el permiso
# de aplicación Sites.Selected y escritura concedida solo sobre el sitio de Kraken (POST /sites/{site-id}/permissions).
# SHAREPOINT_DRIVE_ID: id de la biblioteca de documentos, de GET /sites/{host}:/sites/{nombre}:/drives en Graph.
# SHAREPOINT_FOLDER: carpeta raíz dentro de la biblioteca (por defecto "Kraken").
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Kraken

# Alternativa a SharePoint: carpeta o montaje local de adjuntos. En desarrollo, sin nada configurado, se usa ./.files
FILES_ROOT=

# Solo desarrollo: usuarios de prueba de `pnpm db:seed:dev` y su acceso con contraseña (sin Entra)
AUTH_DEV_PASSWORD_LOGIN=false
DEV_SEED_PASSWORD=
