// deploy/app/alloy.river
// Grafana Alloy en cada nodo de app y en staging: lee los logs JSON de los contenedores de Kraken (app y worker)
// y los manda a Loki con la etiqueta del servicio (AGENTS.md §10 Observabilidad).
// LIMITACIÓN: Loki aún no tiene destino; el servicio alloy solo arranca con --profile logs. Reemplazar <URL_LOKI>.

discovery.docker "kraken" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=kraken"]
  }
}

discovery.relabel "kraken" {
  targets = discovery.docker.kraken.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "servicio"
  }
}

loki.source.docker "kraken" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.kraken.output
  forward_to = [loki.write.ops.receiver]
}

loki.write "ops" {
  endpoint {
    url = "<URL_LOKI>/loki/api/v1/push"
  }
  external_labels = { nodo = constants.hostname }
}
