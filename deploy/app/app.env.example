# deploy/app/app.env.example
# Plantilla de /etc/kraken/app.env en cada nodo (permisos 600, dueño root). Ver AGENTS.md §10 Secretos.
NODE_ENV=production
DATABASE_URL=postgresql://kraken_app:<CLAVE>@host.docker.internal:5000/kraken
MIGRATION_DATABASE_URL=postgresql://kraken_migra:<CLAVE>@host.docker.internal:5000/kraken
BETTER_AUTH_SECRET=<32+ caracteres aleatorios, el mismo en ambos nodos>
BETTER_AUTH_URL=https://kraken.dima.com.bo
# IP de la FortiGate/Radware y de los HAProxy de app-01/app-02 (nunca la red de los clientes).
TRUSTED_PROXIES=10.0.10.1,10.0.20.11,10.0.20.12
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=kraken@dima.com.bo
FX_API_URL=https://apibcb.cucu.bo/api/v1/tc/oficial
