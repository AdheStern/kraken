# deploy/app/app.env.example
# Plantilla de /etc/kraken/app.env en cada nodo de app de producción (dueño root:deploy, permisos 640).
# AGENTS.md §10.
# La base se alcanza por el HAProxy del propio nodo (:5000 → primario de Patroni en lpzvmkrkdb01).
NODE_ENV=production
# REGLA: production en los nodos de producción: Graph y SharePoint obligatorios, sin aviso de pruebas.
APP_ENV=production
DATABASE_URL=postgresql://kraken_app:<CLAVE>@host.docker.internal:5000/kraken
# REGLA: MIGRATION_DATABASE_URL va en migrate.env, nunca aquí (lo leen la app y el worker).
BETTER_AUTH_SECRET=<32+ caracteres aleatorios, el mismo en ambos nodos>
BETTER_AUTH_URL=https://kraken.dima.com.bo
# Proxies de confianza (nunca la red de los clientes): el FortiGate, las IPs de los nodos de app y las redes de Docker,
# porque el HAProxy local llega al contenedor desde docker0 (10.250.0.0/24) o la red de compose (10.251.0.0/16).
# Al crear lpzvmkrkapp02, sumar su IP.
TRUSTED_PROXIES=<IP_FORTIGATE>,172.22.12.112,10.250.0.0/24,10.251.0.0/16
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
MAIL_SENDER=kraken@dima.com.bo
FX_API_URL=https://apibcb.cucu.bo/api/v1/tc/oficial
# Adjuntos en SharePoint (ADR-16): registro de app con Sites.Selected sobre el sitio de Kraken.
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER=Kraken
