# deploy/app/haproxy.env.example
# Plantilla de /etc/kraken/haproxy.env (permisos 600) en cada nodo de app. Las IPs de los servidores web y de
# base están escritas en haproxy.cfg.
# IP del nodo en 172.22.12.0/24 (lpzvmkrkapp01: 172.22.12.112): stats y /metrics de HAProxy escuchan ahí y en
# 127.0.0.1.
STATS_BIND_IP=
