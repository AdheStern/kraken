# deploy/app/migrate.env.example
# Plantilla de /etc/kraken/migrate.env (permisos 600, dueño root): solo la lee el servicio `migrate` del compose.
# REGLA: el dueño del esquema nunca está en el entorno de la app ni del worker (AGENTS.md §4, §10).
MIGRATION_DATABASE_URL=postgresql://kraken_migrator:<CLAVE>@host.docker.internal:5000/kraken
