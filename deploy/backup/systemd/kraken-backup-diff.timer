# deploy/backup/systemd/kraken-backup-diff.timer
# Diferencial diario de lunes a sábado, 02:00 hora de La Paz (el domingo va el completo).
[Unit]
Description=Kraken: respaldo diferencial diario

[Timer]
OnCalendar=Mon..Sat *-*-* 02:00:00 America/La_Paz
Persistent=true
Unit=kraken-backup@diff.service

[Install]
WantedBy=timers.target
