# deploy/backup/systemd/kraken-restore-test.service
# Restauración de prueba en stg-01 (AGENTS.md §10): si falla, el timer lo registra y Uptime Kuma avisa.
[Unit]
Description=Kraken: restauración de prueba del respaldo
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=postgres
ExecStart=/opt/kraken/deploy/scripts/restore-test.sh 1
