# deploy/staging/migrate.env.example
# Plantilla de /etc/kraken/migrate.env en lpzvmkrkstg01 (permisos 600, dueño root): solo la lee el servicio migrate.
# REGLA: el dueño del esquema nunca está en el entorno de la app ni del worker (AGENTS.md §4, §10).
# <CLAVE_MIGRACIONES> = KRAKEN_MIGRATOR_PASSWORD de postgres.env.
MIGRATION_DATABASE_URL=postgresql://kraken_migrator:<CLAVE_MIGRACIONES>@postgres:5432/kraken
