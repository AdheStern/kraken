# deploy/staging/postgres.env.example
# Plantilla de /etc/kraken/postgres.env en lpzvmkrkstg01 (permisos 600, dueño root): solo la lee el servicio
# postgres. Las dos últimas claves las usa initdb/10-kraken-roles.sh una sola vez, con el volumen vacío; cambiarlas
# después exige ALTER ROLE … PASSWORD y actualizar app.env y migrate.env.
POSTGRES_PASSWORD=<clave del superusuario postgres>
KRAKEN_MIGRATOR_PASSWORD=<la de migrate.env>
KRAKEN_APP_PASSWORD=<la de app.env>
