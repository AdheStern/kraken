# deploy/staging/staging.env.example
# Plantilla de /etc/kraken/app.env en lpzvmkrkstg01 (dueño root:deploy, permisos 640). La leen app, worker y migrate.
# Ver AGENTS.md §10 Secretos. Datos anonimizados; nunca las claves de producción.
NODE_ENV=production
# REGLA: staging manda el correo a Mailpit y guarda los adjuntos en FILES_ROOT, nunca en Microsoft 365, y muestra el
# aviso «Entorno de pruebas». Sin esta línea (o con otro valor) rige producción y el worker no arranca sin Graph.
APP_ENV=staging
# La base es el Postgres del compose (servicio postgres); <CLAVE_APP> = KRAKEN_APP_PASSWORD de postgres.env.
DATABASE_URL=postgresql://kraken_app:<CLAVE_APP>@postgres:5432/kraken
# REGLA: MIGRATION_DATABASE_URL va en migrate.env, nunca aquí.
BETTER_AUTH_SECRET=<32+ caracteres aleatorios, distinto del de producción>
BETTER_AUTH_URL=https://stg-kraken.dima.com.bo
# El HAProxy del host llega al contenedor desde las redes de Docker; staging es solo de la red interna.
TRUSTED_PROXIES=172.22.12.117,10.250.0.0/24,10.251.0.0/16
# Inicio de sesión: en Entra, agregar la URI de redirección https://stg-kraken.dima.com.bo/api/auth/callback/microsoft.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Correo: el servicio mailpit del compose; la interfaz web está en http://172.22.12.117:8025 (solo red interna).
# GRAPH_* y MAIL_SENDER no van en staging.
MAILPIT_URL=http://mailpit:8025
FX_API_URL=https://apibcb.cucu.bo/api/v1/tc/oficial
# Adjuntos y documentación: el volumen files del compose (ADR-16, alternativa a SharePoint). SHAREPOINT_* no van en
# staging.
FILES_ROOT=/var/lib/kraken/files
