{
  "name": "kraken",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "skills:install": "pnpm dlx skills experimental_install -y && node -e \"require('fs').cpSync('.agents/skills','.claude/skills',{recursive:true})\"",
    "db:seed:admin": "tsx --env-file-if-exists=.env prisma/seed/seed-super-admin.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.mts",
    "db:seed:dev": "tsx --env-file-if-exists=.env prisma/seed/seed-dev.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "worker:migrate": "tsx --env-file-if-exists=.env src/worker/migrate.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg-boss": "12.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "fast-check": "^4.10.2",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.24.0"
}
