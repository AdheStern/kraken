// prisma/schema/core-catalog.prisma
// Esquema core: catálogos comerciales (clientes, proveedores, tecnologías, unidades, tipos de servicio, productos).

enum ItemType {
  HARDWARE
  INTANGIBLE
  SERVICIO

  @@schema("core")
}

// Tipo de empresa del cliente (decisión 2026-11-06); lista fija.
enum CompanyType {
  PUBLICA
  PRIVADA
  MIXTA
  ONG
  ORGANISMO_INTERNACIONAL
  OTRA

  @@schema("core")
}

// Departamentos y municipios de Bolivia: la ubicación de clientes, sucursales y contactos (decisión 2026-11-06).
// POR QUÉ: aparte de core.ciudad, que son las ciudades operativas de DIMA (correlativo, feriados, almacén).
model Department {
  id   String @id @default(uuid(7)) @db.Uuid
  code String @unique @map("codigo")
  name String @unique @map("nombre")

  municipalities Municipality[]

  @@map("departamento")
  @@schema("core")
}

model Municipality {
  id           String  @id @default(uuid(7)) @db.Uuid
  departmentId String  @map("departamento_id") @db.Uuid
  name         String  @map("nombre")
  isActive     Boolean @default(true) @map("activo")

  department Department        @relation(fields: [departmentId], references: [id])
  customers  Customer[]
  branches   CustomerBranch[]
  contacts   CustomerContact[]

  @@unique([departmentId, name])
  @@map("municipio")
  @@schema("core")
}

// Rubro del cliente: catálogo simple que mantiene Administración (decisión 2026-11-06).
model Industry {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @unique @map("nombre")
  isActive Boolean @default(true) @map("activo")

  customers Customer[]

  @@map("rubro")
  @@schema("core")
}

model Customer {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String       @map("razon_social")
  taxId          String?      @map("nit")
  email          String?      @map("correo")
  phone          String?      @map("telefono")
  address        String?      @map("direccion")
  // POR QUÉ: texto libre de antes del catálogo de municipios; se muestra mientras no se elija un municipio.
  city           String?      @map("ciudad")
  country        String?      @map("pais")
  municipalityId String?      @map("municipio_id") @db.Uuid
  industryId     String?      @map("rubro_id") @db.Uuid
  companyType    CompanyType? @map("tipo_empresa")
  isActive       Boolean      @default(true) @map("activo")
  // Qué permite el portal a la cuenta del cliente; siempre ve sus tickets y sus horas descontadas (§2.11).
  portalSeesBags Boolean      @default(false) @map("portal_ve_bolsas")
  portalRequests Boolean      @default(false) @map("portal_pide_trabajo")
  portalComments Boolean      @default(false) @map("portal_comenta")
  createdAt      DateTime     @default(now()) @map("creado_en") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("actualizado_en") @db.Timestamptz

  municipality        Municipality?     @relation(fields: [municipalityId], references: [id])
  industry            Industry?         @relation(fields: [industryId], references: [id])
  contacts            CustomerContact[]
  branches            CustomerBranch[]
  cvs                 Cv[]
  endCustomerVersions CvVersion[]
  hourBags            HourBag[]
  pendingHours        PendingHours[]
  projects            Project[]
  tickets             Ticket[]
  docProjects         DocProject[]
  portalUsers         UserProfile[]
  ticketRequests      TicketRequest[]

  @@index([taxId])
  @@map("cliente")
  @@schema("core")
}

// Sucursal o subdirección de un cliente en otra ciudad (decisión 2026-11-06). Coordenadas opcionales para el
// mapa, que llega después.
model CustomerBranch {
  id             String   @id @default(uuid(7)) @db.Uuid
  customerId     String   @map("cliente_id") @db.Uuid
  name           String   @map("nombre")
  address        String?  @map("direccion")
  municipalityId String?  @map("municipio_id") @db.Uuid
  phone          String?  @map("telefono")
  latitude       Decimal? @map("latitud") @db.Decimal(9, 6)
  longitude      Decimal? @map("longitud") @db.Decimal(9, 6)
  isActive       Boolean  @default(true) @map("activa")
  createdAt      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  customer     Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  municipality Municipality?     @relation(fields: [municipalityId], references: [id])
  contacts     CustomerContact[]

  @@index([customerId])
  @@map("cliente_sucursal")
  @@schema("core")
}

// Una persona de contacto: la misma ficha aunque cambie de empresa; sus puestos son cliente_contacto (decisión
// 2026-11-06). El nombre normalizado (sin tildes ni mayúsculas) sirve para avisar duplicados.
model ContactPerson {
  id             String   @id @default(uuid(7)) @db.Uuid
  name           String   @map("nombre")
  normalizedName String   @map("nombre_normalizado")
  personalEmail  String?  @map("correo_personal")
  personalPhone  String?  @map("telefono_personal")
  createdAt      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  positions CustomerContact[]

  @@index([normalizedName])
  @@map("persona_contacto")
  @@schema("core")
}

// Puesto de una persona en un cliente: cargo, datos corporativos, municipio, sucursal, áreas de DIMA con las que
// trata y quiénes de DIMA lo atienden; desde/hasta guardan su historial (decisión 2026-11-06).
// POR QUÉ: el nombre se copia de la persona; CV, documentación y auditoría lo leen de aquí sin cambios.
// REGLA: una persona tiene a lo sumo un puesto activo en cada cliente.
model CustomerContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  customerId     String    @map("cliente_id") @db.Uuid
  personId       String    @map("persona_id") @db.Uuid
  name           String    @map("nombre")
  position       String?   @map("cargo")
  email          String?   @map("correo")
  phone          String?   @map("telefono")
  municipalityId String?   @map("municipio_id") @db.Uuid
  branchId       String?   @map("sucursal_id") @db.Uuid
  startedOn      DateTime? @map("desde") @db.Date
  endedOn        DateTime? @map("hasta") @db.Date
  exitReason     String?   @map("motivo_salida")
  isActive       Boolean   @default(true) @map("activo")

  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  person       ContactPerson         @relation(fields: [personId], references: [id])
  municipality Municipality?         @relation(fields: [municipalityId], references: [id])
  branch       CustomerBranch?       @relation(fields: [branchId], references: [id])
  areas        CustomerContactArea[]
  assignees    CustomerContactUser[]
  docProjects  DocProject[]

  @@unique([personId, customerId], map: "puesto_activo_unico", where: raw("activo"))
  @@index([customerId])
  @@index([personId])
  @@map("cliente_contacto")
  @@schema("core")
}

model CustomerContactArea {
  contactId String @map("contacto_id") @db.Uuid
  areaId    String @map("area_id") @db.Uuid

  contact CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  area    Area            @relation(fields: [areaId], references: [id])

  @@id([contactId, areaId])
  @@map("cliente_contacto_area")
  @@schema("core")
}

// Quiénes de DIMA atienden al contacto; solo informativo, no da permisos ni avisos.
model CustomerContactUser {
  contactId String @map("contacto_id") @db.Uuid
  userId    String @map("usuario_id")

  contact CustomerContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    UserProfile     @relation(fields: [userId], references: [userId])

  @@id([contactId, userId])
  @@map("cliente_contacto_usuario")
  @@schema("core")
}

// TRAMPA: "INGRAM", "INGRAM MICRO" e "INGRAM - INT" son un solo proveedor; la modalidad va en la línea del CV.
model Supplier {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @unique @map("nombre")
  taxId    String? @map("nit")
  isActive Boolean @default(true) @map("activo")

  cvLines      CvLine[]
  leasingLines CvLeasingLine[]

  @@map("proveedor")
  @@schema("core")
}

model Technology {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @unique @map("nombre")
  isActive Boolean @default(true) @map("activo")

  products     Product[]
  cvVersions   CvVersion[]
  cvLines      CvLine[]
  leasingLines CvLeasingLine[]
  docProjects  DocProjectTechnology[]

  @@map("tecnologia")
  @@schema("core")
}

// POR QUÉ: isHours marca la unidad que, con tipo SERVICIO, convierte una línea de CV en bolsa (AGENTS.md §2.1).
model Unit {
  id       String  @id @default(uuid(7)) @db.Uuid
  code     String  @unique @map("codigo")
  name     String  @map("nombre")
  isHours  Boolean @default(false) @map("es_horas")
  // POR QUÉ: meses o años; una línea de SERVICIO en esta unidad puede ser un contrato por vigencia (§2.4).
  isTerm   Boolean @default(false) @map("es_plazo")
  isActive Boolean @default(true) @map("activo")

  products Product[]
  cvLines  CvLine[]

  @@map("unidad")
  @@schema("core")
}

model ServiceType {
  id       String  @id @default(uuid(7)) @db.Uuid
  name     String  @unique @map("nombre")
  isActive Boolean @default(true) @map("activo")

  cvVersions CvVersion[]

  @@map("tipo_servicio")
  @@schema("core")
}

model Product {
  id                   String   @id @default(uuid(7)) @db.Uuid
  code                 String   @map("codigo")
  description          String   @map("descripcion")
  technologyId         String?  @map("tecnologia_id") @db.Uuid
  unitId               String?  @map("unidad_id") @db.Uuid
  itemType             ItemType @map("tipo_item")
  isSerialized         Boolean  @default(false) @map("serializado")
  createdFromCv        Boolean  @default(false) @map("creado_desde_cv")
  // POR QUÉ: Almacén crea el producto al ingresar un código que no existe; Administración lo revisa (§2.8, §2.9).
  createdFromInventory Boolean  @default(false) @map("creado_desde_inventario")
  isActive             Boolean  @default(true) @map("activo")
  createdAt            DateTime @default(now()) @map("creado_en") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  technology    Technology?       @relation(fields: [technologyId], references: [id])
  unit          Unit?             @relation(fields: [unitId], references: [id])
  cvLines       CvLine[]
  stocks        Stock[]
  serialUnits   SerialUnit[]
  movementLines InvMovementLine[]
  transferLines TransferLine[]
  reservations  Reservation[]

  @@index([code])
  @@map("producto")
  @@schema("core")
}
