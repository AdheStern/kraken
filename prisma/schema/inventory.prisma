// prisma/schema/inventory.prisma
// Esquema inv: almacenes, stock, seriales, libro de movimientos, traspasos, ajustes y reservas (AGENTS.md §2.8).

enum WarehouseKind {
  FISICO
  TRANSITO
  DEMOSTRACION
  REPUESTOS

  @@schema("inv")
}

enum InvMovementKind {
  INGRESO
  SALIDA
  TRASPASO
  AJUSTE
  DEVOLUCION

  @@schema("inv")
}

enum ReceiptOrigin {
  COMPRA_LOCAL
  IMPORTACION
  INVENTARIO_INICIAL

  @@schema("inv")
}

// POR QUÉ: RESERVADO no se usa; la reserva es por cantidad y el serial se elige al despachar (AGENTS.md §2.8).
enum SerialStatus {
  EN_STOCK
  EN_TRANSITO
  RESERVADO
  DESPACHADO
  BAJA

  @@schema("inv")
}

enum TransferStatus {
  BORRADOR
  EN_TRANSITO
  RECIBIDO
  RECIBIDO_CON_DIFERENCIAS
  CANCELADO

  @@schema("inv")
}

enum AdjustmentStatus {
  PENDIENTE
  APROBADO
  RECHAZADO

  @@schema("inv")
}

enum AdjustmentOrigin {
  MANUAL
  CONTEO
  TRASPASO

  @@schema("inv")
}

enum ReservationStatus {
  ACTIVA
  CONSUMIDA
  LIBERADA

  @@schema("inv")
}

enum ReservationMovementKind {
  CREAR
  AJUSTE
  LIBERAR
  CONSUMIR
  REABRIR

  @@schema("inv")
}

model Warehouse {
  id       String        @id @default(uuid(7)) @db.Uuid
  code     String        @unique @map("codigo")
  name     String        @map("nombre")
  cityId   String?       @map("ciudad_id") @db.Uuid
  kind     WarehouseKind @map("tipo")
  isActive Boolean       @default(true) @map("activo")

  city               City?               @relation(fields: [cityId], references: [id])
  stocks             Stock[]
  serialUnits        SerialUnit[]
  movements          InvMovement[]
  transfersOut       Transfer[]          @relation("TransferOrigin")
  transfersIn        Transfer[]          @relation("TransferDestination")
  adjustmentRequests AdjustmentRequest[]
  reservations       Reservation[]

  // REGLA: un almacén físico activo por ciudad (ahí se reserva, §2.8) y un solo TRANSITO.
  @@unique([cityId], map: "almacen_fisico_ciudad_unico", where: raw("tipo = 'FISICO' AND activo"))
  @@unique([kind], map: "almacen_transito_unico", where: raw("tipo = 'TRANSITO'"))
  @@map("almacen")
  @@schema("inv")
}

// REGLA: cantidad y valor son caché de inv.movimiento_linea, y lo reservado de inv.reserva_movimiento; cambian solo
// junto a su movimiento (AGENTS.md §0.6). POR QUÉ: se guarda el valor total y no el promedio, que se deriva
// (valor ÷ cantidad); así la última unidad que sale se lleva el resto y no quedan centavos huérfanos.
model Stock {
  id               String   @id @default(uuid(7)) @db.Uuid
  warehouseId      String   @map("almacen_id") @db.Uuid
  productId        String   @map("producto_id") @db.Uuid
  quantity         Decimal  @default(0) @map("cantidad") @db.Decimal(14, 2)
  reservedQuantity Decimal  @default(0) @map("cantidad_reservada") @db.Decimal(14, 2)
  valueUsd         Decimal  @default(0) @map("valor_usd") @db.Decimal(18, 2)
  updatedAt        DateTime @updatedAt @map("actualizado_en") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("stock")
  @@schema("inv")
}

model SerialUnit {
  id          String       @id @default(uuid(7)) @db.Uuid
  productId   String       @map("producto_id") @db.Uuid
  serial      String
  warehouseId String?      @map("almacen_id") @db.Uuid
  status      SerialStatus @default(EN_STOCK) @map("estado")
  createdAt   DateTime     @default(now()) @map("creado_en") @db.Timestamptz

  product       Product           @relation(fields: [productId], references: [id])
  warehouse     Warehouse?        @relation(fields: [warehouseId], references: [id])
  movementLines InvMovementLine[]
  transferLines TransferLine[]

  @@unique([productId, serial])
  @@map("unidad_serial")
  @@schema("inv")
}

// REGLA: inmutable (trigger inv.movimiento_inmutable). Cada movimiento afecta un solo almacén (ADR-03).
model InvMovement {
  id                  String          @id @default(uuid(7)) @db.Uuid
  number              Int             @unique @default(autoincrement()) @map("numero")
  kind                InvMovementKind @map("tipo")
  receiptOrigin       ReceiptOrigin?  @map("origen_ingreso")
  warehouseId         String          @map("almacen_id") @db.Uuid
  documentRef         String?         @map("documento_ref")
  cvLineId            String?         @map("cv_linea_id") @db.Uuid
  ticketId            String?         @map("ticket_id") @db.Uuid
  transferId          String?         @map("traspaso_id") @db.Uuid
  adjustmentRequestId String?         @unique @map("solicitud_ajuste_id") @db.Uuid
  notes               String?         @map("notas")
  // POR QUÉ: el POS y los pegados desde Excel reintentan; la clave impide registrar dos veces el mismo documento.
  idempotencyKey      String?         @unique @map("clave_idempotencia")
  actorId             String          @map("actor_id")
  createdAt           DateTime        @default(now()) @map("creado_en") @db.Timestamptz

  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  cvLine            CvLine?            @relation(fields: [cvLineId], references: [id])
  ticket            Ticket?            @relation(fields: [ticketId], references: [id])
  transfer          Transfer?          @relation(fields: [transferId], references: [id])
  adjustmentRequest AdjustmentRequest? @relation(fields: [adjustmentRequestId], references: [id])
  actor             UserProfile        @relation(fields: [actorId], references: [userId])
  lines             InvMovementLine[]

  @@index([warehouseId, createdAt])
  @@map("movimiento")
  @@schema("inv")
}

// POR QUÉ: cantidad y valor con signo (+ entra, − sale del almacén del movimiento); el saldo tras la línea se
// escribe con el stock bloqueado y es el kardex. El costo unitario se deriva (valor ÷ cantidad).
model InvMovementLine {
  id              String  @id @default(uuid(7)) @db.Uuid
  movementId      String  @map("movimiento_id") @db.Uuid
  productId       String  @map("producto_id") @db.Uuid
  quantity        Decimal @map("cantidad") @db.Decimal(14, 2)
  valueUsd        Decimal @map("valor_usd") @db.Decimal(18, 2)
  balanceQuantity Decimal @map("saldo_cantidad") @db.Decimal(14, 2)
  balanceValueUsd Decimal @map("saldo_valor_usd") @db.Decimal(18, 2)
  serialUnitId    String? @map("unidad_serial_id") @db.Uuid
  returnsLineId   String? @map("devuelve_linea_id") @db.Uuid
  transferLineId  String? @map("traspaso_linea_id") @db.Uuid

  movement             InvMovement           @relation(fields: [movementId], references: [id])
  product              Product               @relation(fields: [productId], references: [id])
  serialUnit           SerialUnit?           @relation(fields: [serialUnitId], references: [id])
  returnsLine          InvMovementLine?      @relation("LineReturn", fields: [returnsLineId], references: [id])
  returns              InvMovementLine[]     @relation("LineReturn")
  transferLine         TransferLine?         @relation(fields: [transferLineId], references: [id])
  reservationMovements ReservationMovement[]

  @@index([productId])
  @@index([returnsLineId])
  @@index([transferLineId])
  @@map("movimiento_linea")
  @@schema("inv")
}

// REGLA: dos pasos; al enviar, el stock pasa a TRANSITO y el destino confirma cantidades y seriales (AGENTS.md §2.8).
model Transfer {
  id                     String         @id @default(uuid(7)) @db.Uuid
  number                 Int            @unique @default(autoincrement()) @map("numero")
  originWarehouseId      String         @map("almacen_origen_id") @db.Uuid
  destinationWarehouseId String         @map("almacen_destino_id") @db.Uuid
  status                 TransferStatus @default(BORRADOR) @map("estado")
  notes                  String?        @map("notas")
  createdById            String         @map("creado_por_id")
  createdAt              DateTime       @default(now()) @map("creado_en") @db.Timestamptz
  sentById               String?        @map("enviado_por_id")
  sentAt                 DateTime?      @map("enviado_en") @db.Timestamptz
  receivedById           String?        @map("recibido_por_id")
  receivedAt             DateTime?      @map("recibido_en") @db.Timestamptz

  originWarehouse      Warehouse      @relation("TransferOrigin", fields: [originWarehouseId], references: [id])
  destinationWarehouse Warehouse      @relation("TransferDestination", fields: [destinationWarehouseId], references: [id])
  createdBy            UserProfile    @relation("TransferCreator", fields: [createdById], references: [userId])
  sentBy               UserProfile?   @relation("TransferSender", fields: [sentById], references: [userId])
  receivedBy           UserProfile?   @relation("TransferReceiver", fields: [receivedById], references: [userId])
  lines                TransferLine[]
  movements            InvMovement[]

  @@index([status])
  @@map("traspaso")
  @@schema("inv")
}

// POR QUÉ: lo recibido se suma de los movimientos enlazados (admite recepciones parciales y posteriores) y se
// valoriza contra valor_enviado_usd de esta línea, nunca contra el promedio de TRANSITO, que mezcla traspasos.
model TransferLine {
  id           String   @id @default(uuid(7)) @db.Uuid
  transferId   String   @map("traspaso_id") @db.Uuid
  productId    String   @map("producto_id") @db.Uuid
  quantitySent Decimal  @map("cantidad_enviada") @db.Decimal(14, 2)
  sentValueUsd Decimal? @map("valor_enviado_usd") @db.Decimal(18, 2)
  serialUnitId String?  @map("unidad_serial_id") @db.Uuid
  notes        String?  @map("notas")

  transfer      Transfer          @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  serialUnit    SerialUnit?       @relation(fields: [serialUnitId], references: [id])
  movementLines InvMovementLine[]

  @@index([transferId])
  @@map("traspaso_linea")
  @@schema("inv")
}

// POR QUÉ: el libro es inmutable, así que el ajuste se pide aquí y el movimiento AJUSTE se inserta solo al aprobarse.
model AdjustmentRequest {
  id              String           @id @default(uuid(7)) @db.Uuid
  warehouseId     String           @map("almacen_id") @db.Uuid
  areaId          String?          @map("area_id") @db.Uuid
  origin          AdjustmentOrigin @default(MANUAL) @map("origen")
  status          AdjustmentStatus @default(PENDIENTE) @map("estado")
  reason          String           @map("motivo")
  lines           Json             @map("lineas")
  requestedById   String           @map("solicitado_por_id")
  createdAt       DateTime         @default(now()) @map("creado_en") @db.Timestamptz
  decidedById     String?          @map("decidido_por_id")
  decidedAt       DateTime?        @map("decidido_en") @db.Timestamptz
  decisionComment String?          @map("comentario_decision")

  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  area        Area?        @relation(fields: [areaId], references: [id])
  requestedBy UserProfile  @relation("AdjustmentRequester", fields: [requestedById], references: [userId])
  decidedBy   UserProfile? @relation("AdjustmentDecider", fields: [decidedById], references: [userId])
  movement    InvMovement?

  @@index([status])
  @@map("solicitud_ajuste")
  @@schema("inv")
}

// REGLA: una línea de CV aprobado con STOCK_DIMA reserva stock; el despacho la consume (AGENTS.md §2.8). Cantidades
// y estado son caché de inv.reserva_movimiento. cvLineId sigue a la línea vigente; originLineId es la raíz del linaje.
model Reservation {
  id               String            @id @default(uuid(7)) @db.Uuid
  cvLineId         String            @map("cv_linea_id") @db.Uuid
  originLineId     String            @map("linea_origen_id") @db.Uuid
  warehouseId      String            @map("almacen_id") @db.Uuid
  productId        String            @map("producto_id") @db.Uuid
  quantity         Decimal           @map("cantidad") @db.Decimal(14, 2)
  consumedQuantity Decimal           @default(0) @map("cantidad_consumida") @db.Decimal(14, 2)
  status           ReservationStatus @default(ACTIVA) @map("estado")
  createdAt        DateTime          @default(now()) @map("creado_en") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("actualizado_en") @db.Timestamptz

  cvLine    CvLine                @relation(fields: [cvLineId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  product   Product               @relation(fields: [productId], references: [id])
  movements ReservationMovement[]

  @@unique([originLineId], map: "reserva_activa_unica", where: raw("estado = 'ACTIVA'"))
  @@index([cvLineId])
  @@index([warehouseId, productId, status])
  @@map("reserva")
  @@schema("inv")
}

// REGLA: inmutable (trigger inv.reserva_movimiento_inmutable). Cantidad con signo sobre lo pendiente de la reserva
// (+ reserva o reabre, − libera o consume); CONSUMIR y REABRIR enlazan la línea de salida o devolución.
model ReservationMovement {
  id                String                  @id @default(uuid(7)) @db.Uuid
  reservationId     String                  @map("reserva_id") @db.Uuid
  kind              ReservationMovementKind @map("tipo")
  quantity          Decimal                 @map("cantidad") @db.Decimal(14, 2)
  versionId         String?                 @map("version_id") @db.Uuid
  invMovementLineId String?                 @map("movimiento_linea_id") @db.Uuid
  reason            String?                 @map("motivo")
  actorId           String?                 @map("actor_id")
  createdAt         DateTime                @default(now()) @map("creado_en") @db.Timestamptz

  reservation     Reservation      @relation(fields: [reservationId], references: [id])
  version         CvVersion?       @relation(fields: [versionId], references: [id])
  invMovementLine InvMovementLine? @relation(fields: [invMovementLineId], references: [id])
  actor           UserProfile?     @relation(fields: [actorId], references: [userId])

  @@index([reservationId, createdAt])
  @@map("reserva_movimiento")
  @@schema("inv")
}
